<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <application>
        <activity
            android:name=".openAPSAIMI.advisor.AimiProfileAdvisorActivity"
            android:exported="false"
            android:theme="@style/AppTheme"
            android:label="@string/aimi_advisor_title" />
        <activity
            android:name=".openAPSAIMI.dashboard.CoefficientsDashboardActivity"
            android:exported="false"
            android:theme="@style/AppTheme"
            android:label="@string/coefficients_dashboard_title" />
        <!-- Lets the adb shell (DUMP permission) feed a photo into «Еда по фото» for checks without a camera. -->
        <receiver
            android:name=".openAPSAIMI.food.FoodDebugReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="app.aaps.food.ADD_PHOTO" />
            </intent-filter>
        </receiver>
    </application>

</manifest>