<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <!-- Shared with the relay in the AAPS watch app; signature-level, so only an app signed with
         the same key can hand commands to the controller or receive its answers. -->
    <permission android:name="app.aaps.combo.permission.RELAY" android:protectionLevel="signature" />
    <uses-permission android:name="app.aaps.combo.permission.RELAY" />
    <!-- Held by the sensor app on this watch, which hands its readings to the controller. Signature-level
         for the same reason as the relay: nobody else may tell the controller what the glucose is. -->
    <permission android:name="app.aaps.combo.permission.GLUCOSE" android:protectionLevel="signature" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <queries>
        <package android:name="info.nightscout.androidaps" />
    </queries>

    <application>
        <service android:name=".controller.ControllerService" android:exported="false"
            android:foregroundServiceType="connectedDevice" />
        <receiver android:name=".controller.ControllerAlarmReceiver" android:exported="false" />
        <receiver android:name=".controller.ControllerInboundReceiver" android:exported="true"
            android:permission="app.aaps.combo.permission.RELAY">
            <intent-filter>
                <action android:name="app.aaps.combo.action.FROM_PHONE" />
            </intent-filter>
        </receiver>
        <receiver android:name=".controller.ControllerCarbsReceiver" android:exported="true"
            android:permission="app.aaps.combo.permission.RELAY">
            <intent-filter>
                <action android:name="app.aaps.combo.action.CARBS" />
            </intent-filter>
        </receiver>
        <receiver android:name=".controller.ControllerGlucoseReceiver" android:exported="true"
            android:permission="app.aaps.combo.permission.GLUCOSE">
            <intent-filter>
                <action android:name="app.aaps.combo.action.GLUCOSE" />
            </intent-filter>
        </receiver>
        <receiver android:name=".controller.ControllerDebugReceiver" android:exported="true"
            android:permission="android.permission.DUMP" />
        <!-- The face's three complications: pump, link, forecast. Pushed on events; re-read every five minutes. -->
        <service android:name=".controller.PumpComplicationService" android:label="Combo: помпа" android:exported="true"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter><action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" /></intent-filter>
            <meta-data android:name="android.support.wearable.complications.SUPPORTED_TYPES" android:value="SHORT_TEXT" />
            <meta-data android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS" android:value="300" />
        </service>
        <service android:name=".controller.LinkComplicationService" android:label="Combo: связь" android:exported="true"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter><action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" /></intent-filter>
            <meta-data android:name="android.support.wearable.complications.SUPPORTED_TYPES" android:value="SHORT_TEXT" />
            <meta-data android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS" android:value="300" />
        </service>
        <service android:name=".controller.GraphComplicationService" android:label="Combo: график" android:exported="true"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter><action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" /></intent-filter>
            <meta-data android:name="android.support.wearable.complications.SUPPORTED_TYPES" android:value="SMALL_IMAGE" />
            <meta-data android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS" android:value="300" />
        </service>
        <service android:name=".controller.ForecastComplicationService" android:label="Combo: прогноз" android:exported="true"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter><action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" /></intent-filter>
            <meta-data android:name="android.support.wearable.complications.SUPPORTED_TYPES" android:value="SHORT_TEXT" />
            <meta-data android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS" android:value="300" />
        </service>
        <service android:name=".BackgroundProbeService" android:exported="false"
            android:foregroundServiceType="connectedDevice" />
        <receiver android:name=".BackgroundProbeReceiver" android:exported="false" />
        <service android:name="app.aaps.combobench.PairingForegroundService"
            android:exported="false" android:foregroundServiceType="connectedDevice" />
        <service android:name=".BenchListener" tools:node="remove" />
        <receiver android:name=".BenchCommandReceiver" tools:node="remove" />
    </application>
</manifest>
