<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- To ask the relay app (WearTester's phone side) for a Bluetooth restart when the Wear link is half-open; signature-level, granted at install when WearTester is already there. -->
    <uses-permission android:name="com.example.weartester.permission.LINK_RESET" />

    <application>
        <!-- Its own paths, so the companion's existing listener keeps handling the traffic it
             always handled and needs no change. -->
        <service
            android:name="app.aaps.pump.combowatch.ComboWatchListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/combowatch" />
            </intent-filter>
        </service>
        <!-- adb-only test entry; does nothing outside debuggable builds. -->
        <receiver
            android:name="app.aaps.pump.combowatch.ComboWatchDebugReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
        <!-- adb to the watch through the phone; shell-only, debuggable builds only. See AdbTunnelServer. -->
        <receiver
            android:name="app.aaps.pump.combowatch.AdbTunnelReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
